---
// Recorrido de funciones: el panel y la app dibujados con código, en bucle.
// Reemplaza al video: pesa casi nada, se ve nítido en cualquier pantalla y usa el diseño real de Cheka.
// Cada escena dura DUR ms; sus animaciones viven en CSS y arrancan cuando la escena recibe .activa.
import featuresData from '../data/features.json';
const { header, items } = featuresData;
const DUR = 6500;

// Qué ítem de la barra lateral del panel se marca en cada escena
const menu = ['Inicio', 'Cobros', 'Cajero seguro', 'Analíticas', 'Contabilidad'];
const marca: Record<string, number> = { voice: 0, analytics: 3, cashier: 2, export: 4 };

const filasConta = [
  { h: '09:12', c: 'Juan Pérez', b: 'Yape', m: '25.00' },
  { h: '09:40', c: 'Rosa Quispe', b: 'Plin', m: '48.50' },
  { h: '10:05', c: 'Carlos Huamán', b: 'BCP', m: '120.00', manual: true },
  { h: '10:31', c: 'Lucía Flores', b: 'Yape', m: '12.00' },
  { h: '11:02', c: 'Miguel Torres', b: 'Sip', m: '35.00' },
];
const barras = [
  [40, 18, 62, 22], [55, 25, 48, 30], [35, 30, 70, 26], [72, 20, 66, 34], [60, 35, 88, 28], [85, 28, 74, 40], [92, 22, 96, 30],
];
// QR de muestra de 21×21 (no se puede escanear): tres esquinas de posición y relleno fijo
const enEsquina = (x: number, y: number) => (x < 8 && y < 8) || (x > 12 && y < 8) || (x < 8 && y > 12);
const esquina = (x: number, y: number) => {
  const cx = x > 12 ? x - 14 : x, cy = y > 12 ? y - 14 : y;
  if (cx === 7 || cy === 7) return false;
  return cx === 0 || cx === 6 || cy === 0 || cy === 6 || (cx >= 2 && cx <= 4 && cy >= 2 && cy <= 4);
};
const qr = Array.from({ length: 441 }, (_, k) => {
  const x = k % 21, y = Math.floor(k / 21);
  return enEsquina(x, y) ? esquina(x, y) : ((x * 7 + y * 13 + x * y) % 5) < 2;
});
---

<section
  id="funcionalidades"
  class="relative bg-[var(--color-cheka-light-bg)] dark:bg-[var(--color-cheka-dark-bg)] py-12 md:py-20 px-4 transition-colors duration-300"
  style={`--active-color: ${items[0].color}; --dur: ${DUR}ms;`}
  data-dur={DUR}
>
  <div class="w-full max-w-6xl mx-auto">
    <div class="text-center mb-8 md:mb-12">
      {header.badge && <span class={`inline-block uppercase text-xs md:text-sm mb-2 md:mb-3 ${header.badgeStyle}`}>{header.badge}</span>}
      {header.title && <h2 class={`text-slate-900 dark:text-white leading-tight mb-3 md:mb-4 ${header.titleClass}`} set:html={header.title} />}
      {header.description && <p class={`text-sm md:text-base max-w-2xl mx-auto ${header.descriptionClass}`}>{header.description}</p>}
    </div>

    <!-- Escenario: ventana del panel + teléfono -->
    <div class="escenario" aria-hidden="true">
      <div class="navegador">
        <div class="barra-nav">
          <span class="puntos"><i></i><i></i><i></i></span>
          <span class="url">panel.cheka.pe</span>
        </div>
        <div class="app">
          <aside class="lateral">
            <span class="logo-panel">cheka</span>
            <ul>
              <span class="lat-activo"></span>
              {menu.map((m) => <li><span class="ico"></span>{m}</li>)}
            </ul>
          </aside>

          <div class="vista">
            <!-- 1. Inicio: llega un pago -->
            <div class="escena p-alertas">
              <div class="v-cab"><b>Inicio</b><span class="chip-vivo"><i></i>En vivo</span></div>
              <div class="kpis">
                <div class="kpi marca">
                  <small>Ingresos de hoy</small>
                  <span class="cambia"><b class="viejo">S/ 1,284.50</b><b class="nuevo">S/ 1,309.50</b></span>
                </div>
                <div class="kpi"><small>Por confirmar</small><b>2</b></div>
                <div class="kpi"><small>Turnos activos</small><b>1</b></div>
              </div>
              <div class="tarjeta-p">
                <small class="t">Movimientos en vivo</small>
                <div class="fila-p entra"><span class="av yape">JP</span><span class="q"><b>Juan Pérez</b><small>Yape · ahora</small></span><b class="m">+ S/ 25.00</b></div>
                <div class="fila-p"><span class="av plin">RQ</span><span class="q"><b>Rosa Quispe</b><small>Plin · 09:40</small></span><b class="m">+ S/ 48.50</b></div>
                <div class="fila-p"><span class="av bcp">CH</span><span class="q"><b>Carlos Huamán</b><small>BCP · 09:12</small></span><b class="m">+ S/ 120.00</b></div>
                <div class="fila-p"><span class="av sip">MT</span><span class="q"><b>Miguel Torres</b><small>Sip · 08:55</small></span><b class="m">+ S/ 35.00</b></div>
              </div>
            </div>

            <!-- 2. Analíticas -->
            <div class="escena p-analiticas">
              <div class="v-cab"><b>Analíticas</b>
                <span class="seg"><span class="seg-pildora"></span><i>Ayer</i><i>7 días</i><i>30 días</i></span>
              </div>
              <div class="ana">
                <div class="tarjeta-p grafico">
                  <small class="t">Ingresos y gastos</small>
                  <div class="barras">
                    {barras.map(([a, g, b, g2], i) => (
                      <span class="par" style={`--i: ${i}`}>
                        <i class="ing" style={`--a: ${a}%; --b: ${b}%`}></i>
                        <i class="gas" style={`--a: ${g}%; --b: ${g2}%`}></i>
                      </span>
                    ))}
                  </div>
                </div>
                <div class="tarjeta-p billeteras">
                  <small class="t">Por billetera</small>
                  {[['Yape', 52, 'yape'], ['Plin', 28, 'plin'], ['BCP', 14, 'bcp'], ['Efectivo', 6, 'efe']].map(([n, p, c], i) => (
                    <div class="bill" style={`--p: ${p}%; --i: ${i}`}><span>{n}<b>{p}%</b></span><span class="riel"><i class={String(c)}></i></span></div>
                  ))}
                </div>
              </div>
            </div>

            <!-- 3. Cajero seguro -->
            <div class="escena p-cajero">
              <div class="v-cab"><b>Cajero seguro</b></div>
              <div class="caj">
                <div class="tarjeta-p turno">
                  <small class="t">Nuevo turno</small>
                  <div class="opciones"><span>8 horas</span><span>1 equipo</span><span>Desde ahora</span></div>
                  <span class="btn-p">Crear PIN</span>
                  <div class="pin-p">{'ABC-123'.split('').map((c, i) => <b class:list={{ g: c === '-' }} style={`--i: ${i}`}>{c}</b>)}</div>
                  <small class="vence">Vence solo al terminar el turno</small>
                </div>
                <div class="tarjeta-p activos">
                  <small class="t">Turnos activos</small>
                  <div class="fila-p"><span class="av caj-av">RS</span><span class="q"><b>Rosa · Caja 1</b><small>Quedan 7 h 59 min</small></span></div>
                  <div class="nota-p">Tu cajero no ve totales ni tu balance.</div>
                </div>
              </div>
            </div>

            <!-- 4. Contabilidad y exportación -->
            <div class="escena p-conta">
              <div class="v-cab"><b>Contabilidad</b><span class="btn-p exp">Exportar</span></div>
              <div class="tarjeta-p tabla">
                <div class="tr th"><span>Hora</span><span>Cliente</span><span>Billetera</span><span>Monto</span></div>
                {filasConta.map((f, i) => (
                  <div class:list={['tr', { manual: f.manual }]} style={`--i: ${i}`}>
                    <span>{f.h}</span><span>{f.c}</span><span>{f.b}</span>
                    <span class="mt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">{f.manual ? <path d="M4 20h4L19 9l-4-4L4 16v4z" /> : <><rect x="5" y="11" width="14" height="9" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></>}</svg>S/ {f.m}</span>
                  </div>
                ))}
              </div>
              <div class="archivo"><span class="xls">X</span><span><b>cheka-mayo.xlsx</b><small>Listo para tu contador</small></span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Teléfono -->
      <div class="telefono">
        <div class="cuerpo">
        <div class="pantalla">
          <span class="isla"></span>
          <!-- 1. Notificación + voz -->
          <div class="escena m-alertas">
            <span class="hora">9:41</span>
            <div class="noti"><span class="ico-app yape-bg">Y</span><span><b>Yape</b><small>Juan Pérez te yapeó S/ 25.00</small></span></div>
            <div class="voz-m">
              <span class="ondas"><i></i><i></i><i></i><i></i><i></i><i></i></span>
              <b>Juan Pérez ha yapeado</b>
              <small>Cheka · voz</small>
            </div>
          </div>

          <!-- 2. Analíticas en la app -->
          <div class="escena m-analiticas">
            <b class="m-tit">Analíticas</b>
            <div class="m-card verde"><small>Últimos 7 días</small><b>S/ 8,940.00</b><span class="sube">+12% vs. semana anterior</span></div>
            <div class="m-card">
              <small>Mejores clientes</small>
              {[['Juan Pérez', '1,240'], ['Rosa Quispe', '980'], ['Carlos Huamán', '760']].map(([n, m], i) => <div class="m-fila" style={`--i: ${i}`}><span>{i + 1}. {n}</span><b>S/ {m}</b></div>)}
            </div>
          </div>

          <!-- 3. Terminal del cajero: PIN → QR → check -->
          <div class="escena m-cajero">
            <div class="paso pin-m">
              <b class="m-tit">Ingresa el PIN</b>
              <div class="casillas">{'ABC123'.split('').map((c, i) => <span style={`--i: ${i}`}><b>{c}</b></span>)}</div>
            </div>
            <div class="paso qr-m">
              <b class="m-tit">Cobra con tu QR</b>
              <div class="qr">{qr.map((b) => <i class:list={{ n: b }}></i>)}</div>
              <small>Esperando el pago…</small>
            </div>
            <div class="paso ok-m">
              <span class="check-m"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
              <b>Pago recibido</b>
              <small>Juan Pérez · Yape</small>
            </div>
          </div>

          <!-- 4. Enviar el reporte -->
          <div class="escena m-conta">
            <b class="m-tit">Exportar</b>
            <div class="m-card"><span class="xls">X</span><b>cheka-mayo.xlsx</b><small>124 movimientos · con efectivo</small></div>
            <span class="wsp">Enviar por WhatsApp</span>
            <span class="m-sheets">o abrir en Google Sheets</span>
          </div>
        </div>
        </div>
      </div>
    </div>

    <!-- Pestañas: texto real (accesible) de cada escena -->
    <div class="mt-8 md:mt-10 flex flex-col items-center gap-5">
      <div class="flex flex-wrap justify-center gap-2 md:gap-3" role="tablist" aria-label="Funciones de Cheka">
        {items.map((item, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls="recorrido-texto"
            class="rec-tab group relative overflow-hidden flex items-center gap-2 px-4 md:px-5 py-2.5 rounded-full text-xs md:text-sm font-bold transition-colors duration-300"
            data-index={index}
            data-color={item.color}
            data-marca={marca[item.id]}
          >
            <span class={`w-4 h-4 md:w-5 md:h-5 flex items-center justify-center group-hover:${item.animation}`}>
              <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" set:html={item.icon}></svg>
            </span>
            <span>{item.tabLabel}</span>
            <span class="rec-progreso" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div id="recorrido-texto" class="rec-texto text-center max-w-2xl min-h-[96px]" aria-live="polite">
        {items.map((item, index) => (
          <div class:list={['rec-txt', { activo: index === 0 }]} data-index={index}>
            <h3 class="text-xl md:text-2xl font-black tracking-tight text-slate-900 dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm md:text-base font-medium text-slate-500 dark:text-slate-400">{item.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.getElementById('funcionalidades')!;
  const DUR = Number(sec.dataset.dur);
  const tabs = [...sec.querySelectorAll<HTMLButtonElement>('.rec-tab')];
  const textos = [...sec.querySelectorAll<HTMLElement>('.rec-txt')];
  const escenasP = [...sec.querySelectorAll<HTMLElement>('.vista > .escena')];
  const escenasM = [...sec.querySelectorAll<HTMLElement>('.pantalla > .escena')];
  const lateral = sec.querySelector<HTMLElement>('.lateral')!;
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let actual = 0, reloj: number | undefined, visible = false;

  const mostrar = (i: number) => {
    actual = i;
    sec.style.setProperty('--active-color', tabs[i].dataset.color!);
    lateral.style.setProperty('--lat-i', tabs[i].dataset.marca!);
    tabs.forEach((t, k) => {
      t.setAttribute('aria-selected', String(k === i));
      t.classList.remove('corre');
    });
    textos.forEach((t, k) => t.classList.toggle('activo', k === i));
    // Reinicia las animaciones de la escena: se quita la clase, se fuerza el reflujo y se vuelve a poner
    [...escenasP, ...escenasM].forEach((e) => e.classList.remove('activa'));
    void sec.offsetWidth;
    escenasP[i].classList.add('activa');
    escenasM[i].classList.add('activa');
    if (!quieto && visible && !document.hidden) tabs[i].classList.add('corre');
  };

  const programar = () => {
    clearTimeout(reloj);
    if (quieto || !visible || document.hidden) { tabs[actual].classList.remove('corre'); return; }
    reloj = window.setTimeout(() => { mostrar((actual + 1) % tabs.length); programar(); }, DUR);
  };

  tabs.forEach((t, i) => t.addEventListener('click', () => { mostrar(i); programar(); }));

  new IntersectionObserver(([e]) => {
    const antes = visible;
    visible = e.isIntersecting;
    if (visible && !antes) { mostrar(actual); programar(); }
    if (!visible) { clearTimeout(reloj); }
  }, { threshold: .3 }).observe(sec.querySelector('.escenario')!);
  document.addEventListener('visibilitychange', () => { if (!document.hidden && visible) { mostrar(actual); } programar(); });

  mostrar(0);
</script>

<style>
  /* ---------- Pestañas (diseño original, sin bordes ni sombras) ---------- */
  .rec-tab { background: rgb(255 255 255 / .9); color: #334155; }
  @media (prefers-color-scheme: dark) { .rec-tab { background: rgb(15 23 42 / .8); color: #cbd5e1; } }
  .rec-tab[aria-selected="true"] { background: var(--active-color); color: #fff; }
  .rec-tab:active { transform: scale(.97); }
  .rec-progreso { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: rgb(255 255 255 / .55); transform: scaleX(0); transform-origin: left; }
  .rec-tab.corre .rec-progreso { animation: progreso var(--dur) linear forwards; }
  @keyframes progreso { to { transform: scaleX(1); } }
  .rec-texto { display: grid; }
  .rec-txt { grid-area: 1 / 1; opacity: 0; transform: translateY(6px); filter: blur(4px); transition: opacity .4s var(--curva), transform .4s var(--curva), filter .4s var(--curva); pointer-events: none; }
  .rec-txt.activo { opacity: 1; transform: none; filter: none; pointer-events: auto; }

  /* ---------- Escenario ---------- */
  .escenario {
    /* Paleta del panel (tema claro) */
    --fondo: #F3F5F4; --sup: #FFFFFF; --sup2: #ECF0EE; --tinta: #101814; --suave: #5A6661;
    --marca: #1DD382; --sobre: #06281A; --ing: #087A4A; --gas: #E0662A; --manual: #1D4ED8;
    --lat: #0C1327; --lat-tinta: #F1F3FA; --lat-suave: #A3ABC6;
    --yape: #742284; --plin: #0A6FB0; --bcp: #0A2E8A; --sip: #00739F;
    position: relative; padding: 0 0 6% 0; container-type: inline-size;
    font-family: 'Inter Variable', Inter, system-ui, sans-serif; font-variant-numeric: tabular-nums;
    color: var(--tinta);
  }
  @media (prefers-color-scheme: dark) {
    .escenario {
      --fondo: #0B0F0D; --sup: #151B18; --sup2: #1F2723; --tinta: #EAF1ED; --suave: #9BABA4;
      --ing: #3BE39A; --gas: #FF9A6E; --manual: #8AB0FF; --lat: #111C33;
      --yape: #B06BC6; --plin: #3E9FD8; --bcp: #4F6FD0; --sip: #2BA3CF;
    }
  }

  .navegador { width: 79%; container-type: inline-size; background: var(--sup2); border-radius: 2.2cqw; overflow: hidden; }
  .barra-nav { height: 4.4cqw; display: flex; align-items: center; gap: 2cqw; padding: 0 1.6cqw; }
  .puntos { display: flex; gap: .6cqw; }
  .puntos i { width: 1cqw; height: 1cqw; border-radius: 50%; background: color-mix(in srgb, var(--suave) 45%, transparent); }
  .url { margin: 0 auto; padding: .5cqw 3cqw; border-radius: .9cqw; background: var(--sup); color: var(--suave); font-size: 1.15cqw; font-weight: 500; transform: translateX(-3cqw); }

  .app { display: grid; grid-template-columns: 19% 1fr; aspect-ratio: 16 / 9.4; background: var(--fondo); }
  .lateral { background: var(--lat); color: var(--lat-tinta); padding: 2.2cqw 1.4cqw; display: flex; flex-direction: column; gap: 2.4cqw; }
  .logo-panel { font-family: Mulish, sans-serif; font-weight: 900; font-size: 2.4cqw; letter-spacing: -.035em; padding-left: .8cqw; }
  .lateral ul { position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .4cqw; }
  .lateral li { position: relative; z-index: 1; display: flex; align-items: center; gap: .9cqw; height: 3.4cqw; padding: 0 .9cqw; font-size: 1.2cqw; font-weight: 600; color: var(--lat-suave); white-space: nowrap; }
  .ico { width: 1.5cqw; height: 1.5cqw; border-radius: .45cqw; background: currentColor; opacity: .55; flex: none; }
  /* Menú activo: el fondo se desliza al ítem de la escena (morph) */
  .lat-activo { position: absolute; left: 0; right: 0; top: 0; height: 3.4cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .1); transform: translateY(calc(var(--lat-i, 0) * 3.8cqw)); transition: transform .4s var(--curva); }

  .vista { position: relative; overflow: hidden; }
  .escena { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .4s var(--curva), visibility 0s .4s; }
  .escena.activa { opacity: 1; visibility: visible; transition: opacity .4s var(--curva) .1s, visibility 0s; }
  .vista .escena { padding: 2.4cqw; display: flex; flex-direction: column; gap: 1.6cqw; }

  .v-cab { display: flex; align-items: center; justify-content: space-between; }
  .v-cab > b { font-size: 2.3cqw; font-weight: 700; letter-spacing: -.03em; }
  .chip-vivo { display: inline-flex; align-items: center; gap: .6cqw; padding: .5cqw 1.1cqw; border-radius: .9cqw; background: var(--sup); font-size: 1.1cqw; font-weight: 600; color: var(--suave); }
  .chip-vivo i { width: .8cqw; height: .8cqw; border-radius: 50%; background: var(--ing); }
  .tarjeta-p { background: var(--sup); border-radius: 1.8cqw; padding: 1.6cqw; display: flex; flex-direction: column; gap: .5cqw; min-width: 0; }
  .t { font-size: 1.15cqw; font-weight: 600; color: var(--suave); margin-bottom: .4cqw; }

  /* Escena 1 */
  .kpis { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1.2cqw; }
  .kpi { background: var(--sup); border-radius: 1.8cqw; padding: 1.5cqw 1.6cqw; display: flex; flex-direction: column; gap: .6cqw; }
  .kpi small { font-size: 1.1cqw; font-weight: 600; opacity: .75; }
  .kpi b { font-size: 2.4cqw; font-weight: 700; letter-spacing: -.035em; line-height: 1.1; }
  .kpi.marca { background: var(--marca); color: var(--sobre); }
  .cambia { display: grid; }
  .cambia b { grid-area: 1 / 1; }
  .nuevo { opacity: 0; }
  .activa .viejo { animation: sale-num .4s var(--curva) 2.2s forwards; }
  .activa .nuevo { animation: entra-num .4s var(--curva) 2.25s forwards; }
  @keyframes sale-num { to { opacity: 0; transform: translateY(-40%); filter: blur(3px); } }
  @keyframes entra-num { from { opacity: 0; transform: translateY(40%); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }

  .fila-p { display: flex; align-items: center; gap: 1.1cqw; padding: .8cqw; border-radius: 1.2cqw; }
  .av { width: 3.2cqw; height: 3.2cqw; flex: none; border-radius: 1cqw; display: grid; place-items: center; color: #fff; font-size: 1.1cqw; font-weight: 700; }
  .av.yape { background: var(--yape); } .av.plin { background: var(--plin); } .av.bcp { background: var(--bcp); } .av.sip { background: var(--sip); }
  .av.caj-av { background: var(--marca); color: var(--sobre); }
  .q { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .q b { font-size: 1.3cqw; font-weight: 600; } .q small { font-size: 1.05cqw; color: var(--suave); }
  .m { font-size: 1.35cqw; font-weight: 700; color: var(--ing); }
  /* La fila nueva crece desde 0 (morph de la lista) */
  .entra { display: grid; grid-template-columns: auto 1fr auto; background: var(--sup2); }
  .p-alertas .entra { max-height: 0; padding-block: 0; opacity: 0; }
  .p-alertas.activa .entra { animation: fila-crece .5s var(--curva) 2s forwards; }
