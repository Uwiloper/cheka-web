---
// Aviso de medición: Clarity no carga hasta que el visitante acepta.
import { seccion } from '../lib/contenido';
const c = await seccion('cookies');
---

<div class="cookies" id="cookies" role="region" aria-label="Aviso de medición" hidden>
  <p>{c.texto}</p>
  <div class="acciones">
    <button class="btn btn-suave" type="button" data-cookies="no">{c.rechazar}</button>
    <button class="btn btn-marca" type="button" data-cookies="si">{c.aceptar}</button>
  </div>
</div>

<script>
  const caja = document.getElementById('cookies')!;
  let elegido: string | null = null;
  try { elegido = localStorage.getItem('cheka-cookies'); } catch {}
  if (!elegido) {
    setTimeout(() => { caja.hidden = false; }, 1200);
  }
  caja.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cookies]');
    if (!b) return;
    const v = b.dataset.cookies!;
    try { localStorage.setItem('cheka-cookies', v); } catch {}
    if (v === 'si') (window as any).chekaCargarClarity?.();
    caja.classList.add('sale');
    setTimeout(() => { caja.hidden = true; }, 220);
  });
</script>

<style>
  .cookies {
    position: fixed; z-index: 60; inset: auto 16px 16px auto; width: min(380px, calc(100vw - 32px));
    box-sizing: border-box; padding: 18px; display: flex; flex-direction: column; gap: 14px;
    background: var(--marino); color: var(--marino-tinta); border-radius: var(--r-tarjeta);
    animation: nace .32s var(--salida) both;
  }
  .cookies[hidden] { display: none; }
  .cookies p { margin: 0; font-size: 14px; line-height: 1.5; }
  .acciones { display: flex; gap: 8px; justify-content: flex-end; }
  .acciones .btn { height: 40px; font-size: 14px; }
  .acciones .btn-suave { background: rgba(255, 255, 255, .1); color: inherit; }
  .acciones .btn-suave:hover { background: rgba(255, 255, 255, .16); }
  .sale { opacity: 0; transform: translateY(8px) scale(.98); transition: opacity .2s ease-out, transform .2s ease-out; }
  @keyframes nace { from { opacity: 0; transform: translateY(12px) scale(.98); } }
  @media (max-width: 520px) { .cookies { inset: auto 16px 16px 16px; } }
</style>
