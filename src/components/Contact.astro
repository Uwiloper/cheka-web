---
// src/components/Contact.astro
import contactData from '../data/contact.json';

const { formspreeKey, header, form } = contactData;
---

<section id="contacto" class="relative bg-[var(--color-cheka-light-bg)] dark:bg-[var(--color-cheka-dark-bg)] py-12 md:py-20 lg:py-24 px-4 overflow-hidden transition-colors duration-300">

  <div class="max-w-2xl mx-auto relative z-20">
    
    <div class="text-center">
      {header.badge && <span class={header.badgeClass}>{header.badge}</span>}
      {header.title && <h2 class={header.titleClass} set:html={header.title} />}
      {header.description && <p class={header.descriptionClass}>{header.description}</p>}
    </div>

    <div id="contact-morph-container" class="moving-gradient-wrapper rounded-3xl relative transition-all duration-500">

      <div
        id="card-inner"
        class="bg-[var(--color-cheka-light-card)] dark:bg-[var(--color-cheka-dark-card)] rounded-3xl p-6 md:p-10 transition-all duration-500 flex items-center justify-center relative overflow-hidden"
      >
        
        <div id="form-wrapper" class="w-full relative z-10">
          <form 
            id="cheka-contact-form"
            action={`https://formspree.io/f/${formspreeKey}`} 
            method="POST" 
            class="space-y-5"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {form.fields.map((field) => (
                <div class={field.colSpan ?? "col-span-1"}>
                  <label for={field.id} class={field.labelClass ?? form.defaultLabelClass}>
                    {field.label}
                  </label>
                  
                  {field.type === 'textarea' ? (
                    <textarea 
                      id={field.id} 
                      name={field.name ?? field.id} 
                      rows={field.rows ?? 4} 
                      required={field.required !== false} 
                      placeholder={field.placeholder} 
                      class={field.inputClass ?? form.defaultInputClass}
                    ></textarea>
                  ) : (
                    <input 
                      type={field.type || 'text'} 
                      id={field.id} 
                      name={field.name ?? field.id} 
                      required={field.required !== false} 
                      placeholder={field.placeholder} 
                      class={field.inputClass ?? form.defaultInputClass}
                    />
                  )}
                </div>
              ))}
            </div>

            <button type="submit" id="submit-btn" class={form.submitButton.buttonClass}>
              <span id="submit-text" class={form.submitButton.textClass} data-default={form.submitButton.text} data-sending={form.submitButton.textSending}>
                {form.submitButton.text}
              </span>
              <svg id="submit-icon" class="w-5 h-5 text-slate-900 dark:text-[#090D16] relative z-10 transition-transform duration-300 group-hover/btn:translate-x-1.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
              </svg>
              <div class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-[300%] bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-700 ease-in-out z-0 pointer-events-none"></div>
            </button>
          </form>
        </div>

        <div id="success-wrapper" class="absolute inset-0 flex flex-col items-center justify-center text-center opacity-0 pointer-events-none z-20 py-12 px-6">
          <svg class={form.successState.iconClass} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class={form.successState.textClass}>{form.successState.text}</h3>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @keyframes animated-gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* El degradado solo aparece al enviar: antes se asomaba como un filo en las esquinas */
  .moving-gradient-wrapper:not(.enviado) { background: none; }

  .moving-gradient-wrapper {
    background: linear-gradient(120deg, var(--color-cheka-primary), #059669, #34d399, #10b981, var(--color-cheka-primary));
    background-size: 300% 300%;
    animation: animated-gradient 6s ease infinite;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    // Transición AJAX y Morphing a degradado completo al enviar
    const contactForm = document.getElementById("cheka-contact-form");
    const formWrapper = document.getElementById("form-wrapper");
    const cardInner = document.getElementById("card-inner");
    const successWrapper = document.getElementById("success-wrapper");
    const submitBtn = document.getElementById("submit-btn");
    const submitText = document.getElementById("submit-text");
    const submitIcon = document.getElementById("submit-icon");

    if (contactForm && cardInner && formWrapper && successWrapper) {
      contactForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Feedback inmediato en el botón
        submitText.textContent = submitText.getAttribute('data-sending');
        submitIcon.classList.add('opacity-0');
        submitBtn.classList.add('pointer-events-none', 'opacity-80');

        const formData = new FormData(contactForm);

        try {
          const response = await fetch(contactForm.getAttribute("action"), {
            method: "POST",
            body: formData,
            headers: { 'Accept': 'application/json' }
          });

          if (response.ok) {
            document.getElementById("contact-morph-container")?.classList.add("enviado");
            // MORPHING: 
            // Step 1. Desaparece el formulario
            gsap.to(formWrapper, {
              opacity: 0,
              scale: 0.9,
              y: -15,
              duration: 0.35,
              ease: "power2.in",
              onComplete: () => {
                formWrapper.style.display = "none";
                successWrapper.classList.remove("pointer-events-none");

                // Step 2. Transición del fondo del card a transparente para exponer el verde degradado animado completo
                gsap.to(cardInner, {
                  backgroundColor: "transparent",
                  duration: 0.5,
                  ease: "power2.out"
                });

                // Step 3. El contenedor se reajusta/encoge al tamaño del bloque "Enviado"
                gsap.to(cardInner, {
                  paddingTop: "3.5rem",
                  paddingBottom: "3.5rem",
                  duration: 0.5,
                  ease: "power2.out"
                });

                // Step 4. Aparece el check y el mensaje "Enviado" con animación elástica
                gsap.fromTo(successWrapper,
                  { opacity: 0, scale: 0.7, y: 15 },
                  { opacity: 1, scale: 1, y: 0, duration: 0.5, ease: "back.out(1.7)" }
                );
              }
            });
          } else {
            alert("Hubo un problema al enviar el formulario. Intenta nuevamente.");
            resetButton();
          }
        } catch (error) {
          alert("Error de conexión. Por favor verifica tu red.");
          resetButton();
        }
      });
    }

    function resetButton() {
      submitText.textContent = submitText.getAttribute('data-default');
      submitIcon.classList.remove('opacity-0');
      submitBtn.classList.remove('pointer-events-none', 'opacity-80');
    }
  });
</script>