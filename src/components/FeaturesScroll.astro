---
// src/components/FeaturesScroll.astro
import featuresData from '../data/features.json';
const { header, items } = featuresData;
---

<section id="features-container" class="relative bg-[var(--color-cheka-light-bg)] dark:bg-[var(--color-cheka-dark-bg)] overflow-hidden min-h-screen py-10 md:py-16 flex flex-col justify-between transition-colors duration-300">
  
  <div class="max-w-4xl mx-auto px-6 text-center mb-10 shrink-0 z-20">
    {header.badge && (
      <span class={`inline-block uppercase text-xs md:text-sm mb-2 ${header.badgeStyle}`}>
        {header.badge}
      </span>
    )}
    
    {header.title && (
      <h2 
        class={`text-slate-900 dark:text-white leading-tight mb-4 ${header.titleClass}`}
        set:html={header.title}
      />
    )}
    
    {header.description && (
      <p class={`text-sm md:text-base max-w-2xl mx-auto ${header.descriptionClass}`}>
        {header.description}
      </p>
    )}
  </div>

  <div id="features-track" class="flex flex-row w-[max-content] items-stretch px-6 md:px-[10vw] gap-10 md:gap-24 pb-6 my-auto">
    {items.map((item) => (
      
      /* Contenedor Exterior (Card) con Borde Degradado al Hover */
      <div 
        class={`group relative p-[2px] rounded-3xl transition-all duration-500 bg-[var(--color-cheka-light-border)] dark:bg-[var(--color-cheka-dark-border)] ${item.theme?.hoverBorderGradient || ''} ${item.theme?.hoverGlow || ''} shrink-0 w-[85vw] md:w-[75vw] max-w-[900px] flex flex-col`}
      >
        <div class="relative w-full h-full bg-[var(--color-cheka-light-card)] dark:bg-[var(--color-cheka-dark-card)] rounded-[calc(1.5rem-2px)] p-6 md:p-10 flex flex-col transition-colors duration-300">
          
          {item.tag && (
            <div class={`text-xs md:text-sm font-bold uppercase tracking-widest mb-6 ${item.theme?.tagColor || 'text-slate-500'}`}>
              {item.tag}
            </div>
          )}

          <div class="flex flex-col md:flex-row gap-6 md:gap-10 mb-6">
            
            <div class="flex-1 flex flex-col justify-center">
              {item.title && (
                <h3 class={`text-slate-900 dark:text-white leading-tight mb-2 transition-all duration-300 group-hover:bg-clip-text group-hover:text-transparent group-hover:bg-gradient-to-r ${item.theme?.hoverTextGradient || ''} ${item.titleClass}`}>
                  {item.title}
                </h3>
              )}
              
              {item.slogan && (
                <p class="text-sm md:text-base font-semibold italic text-slate-500 dark:text-slate-400">
                  {item.slogan}
                </p>
              )}
            </div>

            {item.media && (
              <div class="flex-1">
                <div class="w-full aspect-video rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 relative">
                  {item.media.type === 'image' && (
                    <img 
                      src={item.media.url} 
                      alt={item.media.alt || item.title} 
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                  )}
                  {item.media.type === 'video' && (
                    <video 
                      src={item.media.url} 
                      autoplay loop muted playsinline
                      class="w-full h-full object-cover"
                    ></video>
                  )}
                </div>
              </div>
            )}
          </div>

          {item.description && (
            <p class="text-sm md:text-base text-slate-600 dark:text-slate-400 mb-6 max-w-3xl">
              {item.description}
            </p>
          )}

          {item.bullets && item.bullets.length > 0 && (
            <ul class="flex flex-wrap gap-x-6 gap-y-3 mt-auto pt-4 border-t border-[var(--color-cheka-light-border)] dark:border-[var(--color-cheka-dark-border)]">
              {item.bullets.map((bullet) => (
                <li class="flex items-center gap-2 text-xs md:text-sm text-slate-700 dark:text-slate-300">
                  <svg class="w-4 h-4 text-[var(--color-cheka-primary)] shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="font-medium">{bullet}</span>
                </li>
              ))}
            </ul>
          )}

        </div>
      </div>
    ))}
    
    <div class="w-[10vw] shrink-0"></div>
  </div>

</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("features-container");
    const track = document.getElementById("features-track");

    if (!container || !track) return;

    function getScrollAmount() {
      return track.scrollWidth - window.innerWidth;
    }

    const tween = gsap.to(track, {
      x: () => -getScrollAmount(),
      ease: "none"
    });

    ScrollTrigger.create({
      trigger: container,
      pin: true,
      animation: tween,
      scrub: 1,
      invalidateOnRefresh: true,
      end: () => `+=${getScrollAmount()}`
    });
  });
</script>