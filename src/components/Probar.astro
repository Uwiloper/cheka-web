---
// Formulario «Quiero probar Cheka». Lo recibe el panel (/api/postular) y aparece en el admin.
import { seccion } from '../lib/contenido';
import { POSTULAR_URL } from '../config/sitio';
const p = await seccion('probar');
const c = p.campos;
---

<section id="probar" class="probar" aria-labelledby="probar-titulo">
  <div class="contenedor">
    <div class="caja aparece">
      <div class="lado">
        <h2 id="probar-titulo" class="seccion-titulo">{p.titulo}</h2>
        <p>{p.texto}</p>
      </div>

      <form class="form" data-url={POSTULAR_URL} data-enviando={p.enviando} novalidate>
        <div class="campo">
          <label for="f-nombre">{c.nombre}</label>
          <input id="f-nombre" name="nombre" autocomplete="name" required minlength="2" maxlength="60" />
        </div>
        <div class="campo">
          <label for="f-whatsapp">{c.whatsapp}</label>
          <input id="f-whatsapp" name="whatsapp" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="987 654 321" required maxlength="15" />
        </div>
        <div class="campo">
          <label for="f-negocio">{c.negocio}</label>
          <input id="f-negocio" name="negocio" placeholder={c.negocioEjemplo} required minlength="2" maxlength="80" />
        </div>
        <div class="campo">
          <label for="f-lugar">{c.lugar}</label>
          <input id="f-lugar" name="lugar" placeholder={c.lugarEjemplo} maxlength="60" />
        </div>
        <fieldset class="campo ancho">
          <legend>{c.android}</legend>
          <div class="opciones">
            {c.androidOpciones.map((o, i) => (
              <label class="opcion"><input type="radio" name="android" value={o.valor} checked={i === 0} /><span>{o.texto}</span></label>
            ))}
          </div>
        </fieldset>
        {/* Trampa: solo la llenan los robots */}
        <input class="trampa" name="sitio" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="ancho envio">
          <button class="btn btn-marca grande" type="submit"><span data-texto>{p.enviar}</span></button>
          <p class="aviso">{p.aviso}</p>
        </div>
        <p class="estado ancho" role="status" aria-live="polite"></p>

        <div class="listo" aria-hidden="true">
          <span class="ok"><svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
          <b>{p.listo}</b>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.probar .form')!;
  const estado = form.querySelector<HTMLElement>('.estado')!;
  const boton = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
  const texto = boton.querySelector<HTMLElement>('[data-texto]')!;
  const original = texto.textContent!;

  const error = (msg: string, campo?: string) => {
    estado.textContent = msg;
    estado.classList.add('mal');
    if (campo) {
      const el = form.elements.namedItem(campo) as HTMLInputElement | null;
      el?.setAttribute('aria-invalid', 'true');
      el?.focus();
    }
  };

  form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    estado.textContent = ''; estado.classList.remove('mal');
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const wsp = d.whatsapp.replace(/\D/g, '').replace(/^51(?=9\d{8}$)/, '');
    if (d.nombre.trim().length < 2) return error('Escribe tu nombre.', 'nombre');
    if (!/^9\d{8}$/.test(wsp)) return error('Escribe tu WhatsApp de 9 dígitos (empieza con 9).', 'whatsapp');
    if (d.negocio.trim().length < 2) return error('Cuéntanos qué vendes.', 'negocio');

    boton.disabled = true; texto.textContent = form.dataset.enviando!;
    try {
      const r = await fetch(form.dataset.url!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...d, whatsapp: wsp }) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.success) throw new Error(j.error || 'No se pudo enviar.');
      form.classList.add('enviado');
      form.querySelector('.listo')!.setAttribute('aria-hidden', 'false');
    } catch (err) {
      error(err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'No se pudo enviar. Inténtalo en un momento.');
    } finally {
      boton.disabled = false; texto.textContent = original;
    }
  });
</script>

<style>
  .probar { padding: clamp(48px, 6vw, 80px) 0; }
  .caja { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); padding: clamp(24px, 4vw, 48px); border-radius: var(--r-tarjeta); background: var(--marino); color: var(--marino-tinta); }
  .lado { display: flex; flex-direction: column; gap: 14px; }
  .lado p { margin: 0; font-size: 17px; line-height: 1.55; color: var(--marino-suave); }

  .form { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .campo { display: flex; flex-direction: column; gap: 7px; min-width: 0; margin: 0; padding: 0; border: 0; }
  .ancho { grid-column: span 2; }
  label, legend { font-size: 13px; font-weight: 600; color: var(--marino-suave); padding: 0; }
  input:not([type="radio"]) {
    box-sizing: border-box; width: 100%; height: 48px; padding: 0 14px; border: 0;
    border-radius: var(--r-control); background: rgba(255, 255, 255, .08); color: inherit;
    font: inherit; font-size: 16px; transition: background-color .15s ease;
  }
  input::placeholder { color: color-mix(in srgb, var(--marino-suave) 70%, transparent); }
  input:hover { background: rgba(255, 255, 255, .11); }
  input:focus-visible { outline: 2px solid var(--marca); outline-offset: 0; background: rgba(255, 255, 255, .11); }
  input[aria-invalid="true"] { outline: 2px solid #FF8A80; outline-offset: 0; }

  .opciones { display: flex; gap: 6px; flex-wrap: wrap; }
  .opcion { position: relative; cursor: pointer; }
  .opcion input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opcion span { display: inline-flex; align-items: center; height: 44px; padding: 0 18px; border-radius: var(--r-control); background: rgba(255, 255, 255, .08); color: var(--marino-tinta); font-size: 15px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
  .opcion input:checked + span { background: var(--marca); color: var(--sobre); }
  .opcion input:focus-visible + span { outline: 2px solid var(--marca); outline-offset: 2px; }

  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .envio { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 6px; }
  .grande { height: 54px; padding: 0 28px; font-size: 16px; }
  .btn:disabled { opacity: .7; cursor: progress; }
  .aviso { margin: 0; font-size: 13px; color: var(--marino-suave); }
  .estado { margin: 0; min-height: 1px; font-size: 14px; font-weight: 600; }
  .estado.mal { color: #FF8A80; }

  /* Enviado: el formulario se funde en el check */
  .listo { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center; font-size: 18px; opacity: 0; transform: scale(.96); pointer-events: none; transition: opacity .4s var(--curva) .1s, transform .4s var(--curva) .1s; }
  .ok { width: 72px; height: 72px; display: grid; place-items: center; border-radius: var(--r-tarjeta); background: var(--marca); color: var(--sobre); }
  .form > :not(.listo) { transition: opacity .3s ease, filter .3s ease; }
  .enviado > :not(.listo) { opacity: 0; filter: blur(6px); pointer-events: none; }
  .enviado .listo { opacity: 1; transform: none; pointer-events: auto; }

  @media (max-width: 860px) { .caja { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .form { grid-template-columns: 1fr; } .ancho { grid-column: auto; } .envio .btn { width: 100%; } }
</style>
