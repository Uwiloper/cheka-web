---
// Página de error de la web pública (404, 403, 500): el mismo verde y la misma cabecera. Dice qué pasó y ofrece tres
// salidas: la portada, la ayuda y una persona por WhatsApp.
import Base from '../layouts/Base.astro';
import Cabecera from './Cabecera.astro';
import Ic from './app/Ic.astro';
import d from '../data/portada.json';

interface Props { codigo: 404 | 403 | 500 }
const { codigo } = Astro.props;
const TEXTOS = {
  404: { titulo: 'Esta página no existe', texto: 'Puede que el enlace esté mal escrito o que la página se haya movido. Desde aquí puedes volver a lo importante.' },
  403: { titulo: 'No tienes acceso a esta página', texto: 'Esta parte de la web no está abierta al público. Si llegaste desde un enlace de Cheka, escríbenos y lo revisamos.' },
  500: { titulo: 'Algo falló de nuestro lado', texto: 'No fue tu culpa. Vuelve a intentarlo en un momento; si sigue igual, avísanos por WhatsApp.' },
} as const;
const x = TEXTOS[codigo];
const wa = `https://wa.me/${d.whatsapp}?text=${encodeURIComponent(`Hola, en la web de Cheka me salió el error ${codigo}`)}`;
---
<Base titulo={`${x.titulo} | Cheka`} descripcion={x.texto}>
  <meta slot="head" name="robots" content="noindex" />
  <Cabecera />
  <main class="error">
    <span class="error-num" aria-hidden="true">{codigo}</span>
    <div class="error-tarjeta">
      <span class="error-cod">Error {codigo}</span>
      <h1>{x.titulo}</h1>
      <p>{x.texto}</p>
      <div class="error-botones">
        <a href="/" class="boton boton-tinta">Ir al inicio<Ic n="flecha" t={20} g={2.4} /></a>
        <a href="/docs" class="boton error-ayuda">Ver la ayuda</a>
      </div>
      <a href={wa} target="_blank" rel="noopener" class="enlace error-wa"><Ic n="whatsapp" t={18} />Escribir por WhatsApp</a>
    </div>
  </main>
</Base>

<style>
  .error { position: relative; min-height: calc(100svh - var(--alto-cab)); display: grid; place-items: center; padding: 16px var(--lado) 48px; overflow: hidden; }
  .error-num { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -58%); font-size: clamp(160px, 38vw, 420px); font-weight: 800; letter-spacing: -.07em; line-height: 1; color: var(--marca-clara); pointer-events: none; user-select: none; animation: error-flota 7s ease-in-out infinite alternate; }
  .error-tarjeta { position: relative; width: min(540px, 100%); display: flex; flex-direction: column; align-items: center; gap: 14px; padding: clamp(28px, 6vw, 44px) 24px; border-radius: 28px; background: var(--sup); color: var(--tinta); text-align: center; animation: error-entra .6s cubic-bezier(.22, 1, .36, 1) both; }
  .error-cod { font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--ingreso); }
  .error-tarjeta h1 { margin: 0; font-size: clamp(28px, 5vw, 38px); font-weight: 800; letter-spacing: -.04em; line-height: 1.08; text-wrap: balance; }
  .error-tarjeta p { margin: 0; max-width: 420px; font-size: 16px; line-height: 1.55; opacity: .78; text-wrap: pretty; }
  .error-botones { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .error-botones .boton { justify-content: center; }
  .error-ayuda { background: var(--sup2); color: var(--tinta); }
  .error-wa { color: var(--ingreso); }
  @keyframes error-entra { from { opacity: 0; transform: translateY(18px) scale(.98); } }
  @keyframes error-flota { to { transform: translate(-50%, -54%) rotate(-2deg); } }
  @media (max-width: 480px) { .error-botones { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .error-num, .error-tarjeta { animation: none; } }
</style>
