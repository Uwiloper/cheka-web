---
// Portada: diseño original del usuario (sin sombras ni bordes) + recorrido de funciones hecho con código.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BanksCarousel from '../components/BanksCarousel.astro';
import Recorrido from '../components/Recorrido.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';

const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cheka',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Android, Web',
  inLanguage: 'es-PE',
  description: 'Cheka confirma al instante los pagos de Yape, Plin y bancos del Perú leyendo los avisos del celular, y avisa por voz quién pagó.',
  url: Astro.site?.href,
};
---

<Base
  titulo="Cheka | Valida tus ingresos en automático"
  descripcion="Cheka lee los avisos de Yape, Plin y tus bancos en tu celular y los confirma al instante en un panel, con voz. Para negocios del Perú."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(app)} />
  <Header />
  <Hero />
  <BanksCarousel />
  <Recorrido />
  <Pricing />
  <Contact />
  <Faq />
</Base>
