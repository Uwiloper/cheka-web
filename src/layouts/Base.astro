---
// Esqueleto de todas las páginas: idioma, metadatos, canónica, tarjetas para redes y medición.
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import Chatbot from '../components/Chatbot.astro';
import { CARGA_GTM, CLARITY_ID, ES_PRODUCCION, GTM_ID } from '../config/sitio';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
  /** Portada tipo app: la página no se desplaza. Las páginas de texto no lo usan. */
  app?: boolean;
}

const { titulo, descripcion, imagen = '/og.png', app = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    {/* Google Tag Manager con modo de consentimiento: nada guarda cookies de medición ni de anuncios hasta que el
        visitante toca «Aceptar todas» (CookieConsent llama a chekaConsentir). Ver src/config/sitio.ts. */}
    {CARGA_GTM && (
      <script is:inline define:vars={{ GTM_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        var acepto = null;
        try { acepto = localStorage.getItem('cheka_cookie_consent'); } catch (e) {}
        var estado = acepto === 'granted' ? 'granted' : 'denied';
        window.gtag('consent', 'default', { analytics_storage: estado, ad_storage: estado, ad_user_data: estado, ad_personalization: estado, wait_for_update: 500 });
        window.chekaConsentir = function () {
          window.gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' });
          window.dataLayer.push({ event: 'consentimiento_aceptado' });
        };
        (function (w, d, s, l, i) {
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', GTM_ID);
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {!ES_PRODUCCION && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1DD382" />
    {/* Con JavaScript la portada funciona como app (sin desplazar); sin él queda como página larga. */}
    {app && <script is:inline>document.documentElement.classList.add('js');</script>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Cheka" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />

    {/* Clarity: solo en producción y solo después de que el visitante acepta (CookieConsent). */}
    <script is:inline define:vars={{ CLARITY_ID, ES_PRODUCCION }}>
      window.chekaCargarClarity = function () {
        if (!ES_PRODUCCION || window.clarity) return;
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', CLARITY_ID);
      };
    </script>
  </head>
  <body>
    {CARGA_GTM && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <slot />
    {app && <Chatbot />}
    <CookieConsent />
  </body>
</html>
