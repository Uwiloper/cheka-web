---
// Página de texto simple (legal, promociones, libro de reclamaciones, blog): se desplaza normal, con el mismo verde y
// la misma cabecera que la portada.
import Base from './Base.astro';
import Cabecera from '../components/Cabecera.astro';
interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;
---
<Base titulo={`${titulo} | Cheka`} descripcion={descripcion}>
  <Cabecera />
  <div class="hoja">
    <main class="hoja-cuerpo">
      <h1>{titulo}</h1>
      <slot />
    </main>
  </div>
</Base>
