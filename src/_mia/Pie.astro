---
import { seccion } from '../lib/contenido';
import { PANEL_URL } from '../config/sitio';
const p = await seccion('pie');
const derechos = p.derechos.replace('{año}', String(new Date().getFullYear()));
---

<footer class="pie">
  <div class="contenedor rejilla">
    <div class="marca">
      <a href="/" class="logo">cheka</a>
      <p>{p.lema}</p>
    </div>
    {p.columnas.map((c) => (
      <nav aria-label={c.titulo}>
        <h2 class="etiqueta">{c.titulo}</h2>
        <ul>{c.enlaces.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}</ul>
      </nav>
    ))}
    <nav aria-label="Cuenta">
      <h2 class="etiqueta">Cuenta</h2>
      <ul><li><a href={PANEL_URL}>Ingresar al panel</a></li></ul>
    </nav>
  </div>
  <div class="contenedor base"><small>{derechos}</small></div>
</footer>

<style>
  .pie { padding: 56px 0 32px; background: var(--sup); }
  .rejilla { display: grid; grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr)); gap: 32px; }
  .logo { font-size: 32px; color: var(--tinta); text-decoration: none; }
  .marca p { margin: 10px 0 0; color: var(--suave); font-size: 15px; }
  h2 { margin: 0 0 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  a:not(.logo) { display: inline-block; padding: 6px 0; color: var(--tinta); font-size: 15px; text-decoration: none; }
  a:not(.logo):hover { color: var(--marca-texto); }
  .base { margin-top: 40px; color: var(--suave); }
  @media (max-width: 760px) { .rejilla { grid-template-columns: 1fr 1fr; } .marca { grid-column: span 2; } }
</style>
