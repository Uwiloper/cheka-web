---
import { seccion } from '../lib/contenido';
const p = await seccion('preguntas');

// Datos estructurados para Google y buscadores con IA.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.lista.map((q) => ({ '@type': 'Question', name: q.pregunta, acceptedAnswer: { '@type': 'Answer', text: q.respuesta } })),
};
---

<section id="preguntas" class="preguntas" aria-labelledby="preguntas-titulo">
  <div class="contenedor rejilla">
    <div class="lado aparece">
      <h2 id="preguntas-titulo" class="seccion-titulo">{p.titulo}</h2>
      <a class="btn btn-suave" href={p.masAyuda.url}>{p.masAyuda.texto}</a>
    </div>
    <div class="lista aparece">
      {p.lista.map((q) => (
        <details class="tarjeta" name="preguntas">
          <summary>{q.pregunta}<span class="signo" aria-hidden="true"></span></summary>
          <p>{q.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .preguntas { padding: clamp(48px, 6vw, 80px) 0; }
  .rejilla { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .lado { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; position: sticky; top: 96px; }
  .lista { display: flex; flex-direction: column; gap: 8px; }

  details { interpolate-size: allow-keywords; }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; font-size: 16.5px; font-weight: 600; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .signo { position: relative; width: 14px; height: 14px; flex: none; }
  .signo::before, .signo::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 2px; background: var(--suave); transition: transform .3s var(--curva); }
  .signo::after { transform: rotate(90deg); }
  details[open] .signo::after { transform: rotate(0); }
  details p { margin: 0; padding: 0 22px 20px; font-size: 15.5px; line-height: 1.55; color: var(--suave); }

  /* Abrir y cerrar con altura animada donde el navegador lo permite */
  details::details-content { block-size: 0; overflow: clip; transition: block-size .32s var(--curva), content-visibility .32s allow-discrete; }
  details[open]::details-content { block-size: auto; }

  @media (max-width: 860px) { .rejilla { grid-template-columns: 1fr; } .lado { position: static; } }
</style>
