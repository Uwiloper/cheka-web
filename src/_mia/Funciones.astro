---
// Bento de los 6 módulos. Cada tarjeta trae una mini demo; «Ver más» la transforma en su detalle.
import { seccion } from '../lib/contenido';
const f = await seccion('funciones');
const barras = { ayer: [40, 62, 35, 80, 55, 70, 90], semana: [55, 48, 72, 66, 84, 92, 78], mes: [70, 76, 68, 88, 82, 95, 100] };
---

<section id="funciones" class="funciones" aria-labelledby="funciones-titulo">
  <div class="contenedor">
    <div class="cab aparece">
      <h2 id="funciones-titulo" class="seccion-titulo">{f.titulo}</h2>
      <p class="seccion-texto">{f.texto}</p>
    </div>

    <div class="bento">
      {f.modulos.map((m) => (
        <article class:list={['tarjeta', 'mod', 'aparece', `mod-${m.clave}`]} data-mod={m.clave}>
          <div class="visual" aria-hidden="true">
            {m.clave === 'voz' && (
              <div class="v-voz">
                <span class="ondas"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
                <span class="burbuja">Juan Pérez ha yapeado</span>
              </div>
            )}
            {m.clave === 'cajero' && (
              <div class="v-cajero">
                <span class="pin">{'ABC-123'.split('').map((c) => <b class:list={{ guion: c === '-' }}>{c}</b>)}</span>
                <span class="check"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
              </div>
            )}
            {m.clave === 'analiticas' && (
              <div class="v-ana">
                <div class="barras">{barras.semana.map((h) => <span style={`--h: ${h}%`}></span>)}</div>
              </div>
            )}
            {m.clave === 'auditoria' && (
              <div class="v-aud">
                <span class="r"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="9" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>Yape · Juan Pérez<b>+ S/ 25.00</b></span>
                <span class="r"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="9" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>BCP · Rosa Quispe<b>+ S/ 120.00</b></span>
                <span class="r manual"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20h4L19 9l-4-4L4 16v4z" /></svg>Escrito por ti<b>+ S/ 48.50</b></span>
              </div>
            )}
            {m.clave === 'exportar' && (
              <div class="v-exp">
                {Array.from({ length: 4 }).map((_, i) => <span class:list={['celda-fila', { cab: i === 0 }]}><i></i><i></i><i></i></span>)}
              </div>
            )}
            {m.clave === 'asistente' && (
              <div class="v-asi">
                <span class="msj yo">¿Cuánto vendí ayer?</span>
                <span class="msj el">S/ 1,284.50 en 42 pagos. Tu mejor cliente fue Juan Pérez.</span>
              </div>
            )}
          </div>

          {m.clave === 'analiticas' && (
            <div class="segmento" role="group" aria-label="Periodo de ejemplo">
              <span class="pildora" aria-hidden="true"></span>
              <button type="button" data-periodo="ayer" aria-pressed="false">Ayer</button>
              <button type="button" data-periodo="semana" aria-pressed="true">7 días</button>
              <button type="button" data-periodo="mes" aria-pressed="false">30 días</button>
            </div>
          )}

          <div class="pie">
            <h3>{m.titulo}</h3>
            <p>{m.resumen}</p>
          </div>
          <button type="button" class="abrir" aria-haspopup="dialog" aria-controls={`det-${m.clave}`}>
            <span class="sr">Ver más sobre {m.titulo}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </button>
        </article>
      ))}
    </div>
  </div>

  {f.modulos.map((m) => (
    <dialog id={`det-${m.clave}`} class:list={['detalle', `mod-${m.clave}`]} aria-labelledby={`det-${m.clave}-t`}>
      <div class="det-panel">
        <div class="det-cont">
          <h3 id={`det-${m.clave}-t`}>{m.titulo}</h3>
          <p class="det-res">{m.resumen}</p>
          <ul>{m.detalle.map((d) => <li>{d}</li>)}</ul>
          <a class="btn btn-marca" href={m.enlace.url}>{m.enlace.texto}</a>
        </div>
        <button type="button" class="cerrar" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
    </dialog>
  ))}
</section>

<script is:inline type="application/json" id="barras-datos" set:html={JSON.stringify(barras)} />

<script>
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CURVA = 'cubic-bezier(.2, .8, .2, 1)';

  // --- Las demos se animan solo a la vista ---
  const vistas = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('en-vista', e.isIntersecting)), { threshold: .35 });
  document.querySelectorAll('.mod').forEach((m) => vistas.observe(m));

  // --- Periodo de analíticas: la píldora viaja y las barras cambian ---
  const datos = JSON.parse(document.getElementById('barras-datos')!.textContent!);
  const seg = document.querySelector<HTMLElement>('.segmento');
  if (seg) {
    const pildora = seg.querySelector<HTMLElement>('.pildora')!;
    const barras = [...document.querySelectorAll<HTMLElement>('.v-ana .barras span')];
    const mover = (b: HTMLElement) => {
      pildora.style.width = b.offsetWidth + 'px';
      pildora.style.transform = `translateX(${b.offsetLeft - 4}px)`;
    };
    const activo = () => seg.querySelector<HTMLElement>('[aria-pressed="true"]')!;
    requestAnimationFrame(() => { mover(activo()); pildora.classList.add('lista'); });
    addEventListener('resize', () => mover(activo()));
    seg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-periodo]');
      if (!b) return;
      seg.querySelectorAll('[data-periodo]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      mover(b);
      (datos[b.dataset.periodo!] as number[]).forEach((h, i) => barras[i]?.style.setProperty('--h', h + '%'));
    });
  }

  // --- Tarjeta → detalle (morph FLIP) ---
  const desde = (tarjeta: HTMLElement, panel: HTMLElement) => {
    const a = tarjeta.getBoundingClientRect(), b = panel.getBoundingClientRect();
    return `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.width / b.width}, ${a.height / b.height})`;
  };

  document.querySelectorAll<HTMLElement>('.mod').forEach((tarjeta) => {
    const dlg = document.getElementById(`det-${tarjeta.dataset.mod}`) as HTMLDialogElement;
    const panel = dlg.querySelector<HTMLElement>('.det-panel')!;
    const cont = dlg.querySelector<HTMLElement>('.det-cont')!;
    const abrir = tarjeta.querySelector<HTMLButtonElement>('.abrir')!;
    let cerrando = false;

    // Toda la tarjeta abre el detalle, salvo sus controles propios (el periodo de analíticas).
    tarjeta.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      abrir.click();
    });

    abrir.addEventListener('click', () => {
      dlg.showModal();
      if (quieto) return;
      tarjeta.style.visibility = 'hidden';
      panel.animate([{ transform: desde(tarjeta, panel) }, { transform: 'none' }], { duration: 400, easing: CURVA });
      cont.animate([{ opacity: 0, filter: 'blur(4px)' }, { opacity: 1, filter: 'none' }], { duration: 280, delay: 140, easing: 'ease-out', fill: 'backwards' });
    });

    const cerrar = async () => {
      if (cerrando) return;
      if (quieto) { dlg.close(); return; }
      cerrando = true;
      cont.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: 'ease-out', fill: 'forwards' });
      dlg.classList.add('cerrando');
      await panel.animate([{ transform: 'none' }, { transform: desde(tarjeta, panel) }], { duration: 340, easing: CURVA, fill: 'forwards' }).finished;
      dlg.close();
    };

    dlg.addEventListener('close', () => {
      tarjeta.style.visibility = '';
      dlg.classList.remove('cerrando');
      panel.getAnimations().forEach((a) => a.cancel());
      cont.getAnimations().forEach((a) => a.cancel());
      cerrando = false;
      abrir.focus({ preventScroll: true });
    });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); cerrar(); });
    dlg.querySelector('.cerrar')!.addEventListener('click', cerrar);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) cerrar(); });
  });
</script>

<style>
  .funciones { padding: clamp(48px, 6vw, 80px) 0; }
  .cab { display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }

  /* Áreas fijas: 6 tarjetas en 2 filas sin huecos */
  .bento {
    display: grid; gap: 12px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas: "voz voz cajero analiticas" "auditoria exportar cajero asistente";
  }
  .mod-voz { grid-area: voz; } .mod-cajero { grid-area: cajero; } .mod-analiticas { grid-area: analiticas; }
  .mod-auditoria { grid-area: auditoria; } .mod-exportar { grid-area: exportar; } .mod-asistente { grid-area: asistente; }
  .mod { position: relative; padding: 64px 24px 24px; display: flex; flex-direction: column; gap: 18px; min-height: 320px; transition: transform .5s var(--salida), opacity .6s var(--salida), filter .6s var(--salida); }
  .mod:has(.abrir:active) { transform: scale(.985); }

  .visual { flex: 1; display: grid; place-items: center; min-height: 120px; }
  .pie { display: flex; flex-direction: column; gap: 6px; }
  h3 { margin: 0; font-size: 19px; font-weight: 700; letter-spacing: -.02em; }
  .pie p { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--suave); text-wrap: pretty; }

  /* Toda la tarjeta abre el detalle; los controles internos quedan encima */
  .mod { cursor: pointer; }
  .abrir { position: absolute; top: 16px; right: 16px; width: 40px; height: 40px; padding: 0; border: 0; border-radius: var(--r-control); display: grid; place-items: center; background: var(--sup2); color: var(--tinta); cursor: pointer; transition: background-color .2s ease; }
  .abrir svg { transition: transform .24s var(--salida); }
  .mod:hover .abrir svg { transform: rotate(90deg); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Voz */
  .mod-voz { background: var(--marino); color: var(--marino-tinta); }
  .mod-voz .pie p { color: var(--marino-suave); }
  .mod-voz .abrir { color: inherit; background: rgba(255, 255, 255, .1); }
  .v-voz { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .ondas { display: flex; gap: 5px; height: 48px; align-items: center; }
  .ondas i { width: 6px; height: 100%; border-radius: 4px; background: var(--marca); transform: scaleY(.2); }
  .en-vista .ondas i { animation: onda 1.6s var(--curva) infinite; }
  .ondas i:nth-child(2) { animation-delay: .08s !important; } .ondas i:nth-child(3) { animation-delay: .16s !important; }
  .ondas i:nth-child(4) { animation-delay: .24s !important; } .ondas i:nth-child(5) { animation-delay: .32s !important; }
  .ondas i:nth-child(6) { animation-delay: .4s !important; } .ondas i:nth-child(7) { animation-delay: .48s !important; }
  @keyframes onda { 0%, 70%, 100% { transform: scaleY(.2); } 20% { transform: scaleY(1); } 40% { transform: scaleY(.5); } }
  .burbuja { padding: 10px 16px; border-radius: var(--r-control); background: rgba(255, 255, 255, .1); font-size: 15px; font-weight: 600; }

  /* Cajero: PIN → check verde */
  .v-cajero { position: relative; display: grid; place-items: center; width: 100%; height: 100%; min-height: 220px; }
  .pin, .check { grid-area: 1 / 1; }
  .pin { display: flex; gap: 4px; }
  .pin b { width: 30px; height: 42px; display: grid; place-items: center; border-radius: var(--r-chip); background: var(--sup2); font-size: 20px; font-weight: 700; }
  .pin b.guion { width: 12px; background: none; color: var(--suave); }
  .check { width: 96px; height: 96px; border-radius: var(--r-tarjeta); display: grid; place-items: center; background: var(--marca); color: var(--sobre); opacity: 0; transform: scale(.9); }
  .en-vista .pin { animation: pin 5s var(--curva) infinite; }
  .en-vista .check { animation: check 5s var(--curva) infinite; }
  @keyframes pin { 0%, 42% { opacity: 1; transform: none; filter: none; } 50%, 92% { opacity: 0; transform: scale(.94); filter: blur(4px); } 100% { opacity: 1; transform: none; filter: none; } }
  @keyframes check { 0%, 44% { opacity: 0; transform: scale(.9); } 54%, 90% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; transform: scale(.9); } }

  /* Analíticas */
  .v-ana { width: 100%; height: 100%; }
  .barras { height: 130px; display: flex; align-items: flex-end; gap: 8px; }
  .barras span { flex: 1; height: var(--h); border-radius: var(--r-chip) var(--r-chip) 4px 4px; background: var(--marca); transition: height .4s var(--curva); }
  .barras span:nth-child(odd) { background: color-mix(in srgb, var(--marca) 55%, var(--sup2)); }
  .segmento { position: relative; z-index: 1; align-self: flex-start; display: flex; gap: 2px; padding: 4px; border-radius: calc(var(--r-control) + 4px); background: var(--sup2); }
  .segmento button { position: relative; z-index: 1; height: 34px; padding: 0 12px; border: 0; border-radius: var(--r-control); background: none; font: inherit; font-size: 13px; font-weight: 600; color: var(--suave); cursor: pointer; transition: color .2s ease; }
  .segmento button[aria-pressed="true"] { color: var(--fondo); }
  .pildora { position: absolute; top: 4px; left: 4px; height: 34px; border-radius: var(--r-control); background: var(--tinta); }
  .pildora.lista { transition: transform .4s var(--curva), width .4s var(--curva); }

  /* Auditoría */
  .v-aud { width: 100%; display: flex; flex-direction: column; gap: 6px; }
  .r { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: var(--r-control); background: var(--sup2); font-size: 13px; font-weight: 600; color: var(--suave); }
  .r b { margin-left: auto; color: var(--ingreso); }
  .r.manual, .r.manual b { color: #1D4ED8; }
  @media (prefers-color-scheme: dark) { .r.manual, .r.manual b { color: #8AB0FF; } }

  /* Exportar */
  .v-exp { width: 100%; display: flex; flex-direction: column; gap: 4px; }
  .celda-fila { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 4px; }
  .celda-fila i { height: 26px; border-radius: 6px; background: var(--sup2); }
  .celda-fila.cab i { background: var(--ingreso); opacity: .85; }
  .en-vista .celda-fila:not(.cab) i { animation: celda 3.2s ease-in-out infinite; }
  .celda-fila:nth-child(3) i { animation-delay: .2s !important; } .celda-fila:nth-child(4) i { animation-delay: .4s !important; }
  @keyframes celda { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

  /* Asistente */
  .v-asi { width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: 8px; }
  .msj { max-width: 85%; padding: 10px 14px; border-radius: var(--r-control); font-size: 14px; line-height: 1.45; }
  .yo { align-self: flex-end; background: var(--marca); color: var(--sobre); font-weight: 600; }
  .el { align-self: flex-start; background: var(--sup2); }

  /* Detalle (dialog) */
  .detalle { border: 0; padding: 0; margin: auto; background: transparent; max-width: none; max-height: none; overflow: visible; color: var(--tinta); }
  .detalle::backdrop { background: var(--velo); backdrop-filter: blur(4px); transition: opacity .3s ease; }
  @starting-style { .detalle[open]::backdrop { opacity: 0; } }
  .detalle.cerrando::backdrop { opacity: 0; }
  .det-panel { position: relative; transform-origin: top left; box-sizing: border-box; width: min(560px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow: auto; padding: 32px; border-radius: var(--r-tarjeta); background: var(--sup); }
  .detalle.mod-voz .det-panel { background: var(--marino); color: var(--marino-tinta); }
  .det-cont { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .det-cont h3 { font-size: 26px; padding-right: 48px; }
  .det-res { margin: 0; font-size: 16px; line-height: 1.5; color: var(--suave); }
  .mod-voz .det-res { color: var(--marino-suave); }
  .det-cont ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .det-cont li { position: relative; padding-left: 26px; font-size: 15.5px; line-height: 1.5; }
  .det-cont li::before { content: ''; position: absolute; left: 4px; top: .55em; width: 10px; height: 6px; border-left: 2.5px solid var(--ingreso); border-bottom: 2.5px solid var(--ingreso); transform: rotate(-45deg); }
  .cerrar { position: absolute; top: 20px; right: 20px; width: 40px; height: 40px; border: 0; border-radius: var(--r-control); display: grid; place-items: center; background: var(--sup2); color: inherit; cursor: pointer; }
  .mod-voz .cerrar { background: rgba(255, 255, 255, .1); }

  @media (max-width: 1000px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "voz voz" "cajero analiticas" "cajero auditoria" "exportar asistente"; }
  }
  @media (max-width: 620px) {
    .bento { grid-template-columns: 1fr; grid-template-areas: "voz" "cajero" "analiticas" "auditoria" "exportar" "asistente"; }
    .mod { min-height: 0; }
    .v-cajero { min-height: 140px; }
  }
</style>
