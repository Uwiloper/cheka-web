---
import { seccion } from '../lib/contenido';
const p = await seccion('pasos');
---

<section id="como-funciona" class="pasos" aria-labelledby="pasos-titulo">
  <div class="contenedor">
    <h2 id="pasos-titulo" class="seccion-titulo aparece">{p.titulo}</h2>
    <ol>
      {p.pasos.map((s, i) => (
        <li class="tarjeta aparece" style={`transition-delay: ${i * 80}ms`}>
          <span class="n">{i + 1}</span>
          <h3>{s.titulo}</h3>
          <p>{s.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pasos { padding: clamp(48px, 6vw, 80px) 0; }
  ol { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; counter-reset: paso; }
  li { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .n { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--r-control); background: var(--marca); color: var(--sobre); font-size: 18px; font-weight: 700; margin-bottom: 12px; }
  h3 { margin: 0; font-size: 19px; font-weight: 700; letter-spacing: -.02em; }
  p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--suave); }
  @media (max-width: 760px) { ol { grid-template-columns: 1fr; } }
</style>
