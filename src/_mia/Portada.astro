---
import { seccion, soles } from '../lib/contenido';
const p = await seccion('portada');

const iniciales = (n: string) => n.split(' ').map((s) => s[0]).slice(0, 2).join('');
// Las primeras filas se pintan en el servidor: la demo se ve completa aunque no corra JS.
const inicio = p.demo.slice(0, 3);
const totalInicial = 1284.5;
---

<section class="portada">
  <div class="contenedor rejilla">
    <div class="texto">
      <span class="chip vivo"><span class="punto" aria-hidden="true"></span>{p.etiqueta}</span>

      <h1>
        <span class="linea">{p.antes} <span class="palabras" aria-hidden="true">
          {p.palabras.map((w, i) => <span class:list={['palabra', { activa: i === 0 }]} style={`color: var(--${w.color})`}>{w.texto}</span>)}
        </span><span class="sr-only">{p.palabras.map((w) => w.texto).join(', ')}</span></span>
        <span class="linea">{p.despues}</span>
      </h1>

      <p class="desc">{p.descripcion}</p>

      <div class="botones">
        <a class="btn btn-marca grande" href={p.principal.url}>{p.principal.texto}</a>
        <a class="btn btn-suave grande" href={p.secundario.url}>{p.secundario.texto}</a>
      </div>
    </div>

    <div class="demo" aria-label={`Panel de Cheka. ${p.nota}.`} role="img">
      <div class="tarjeta total">
        <span class="etiqueta-demo">Ingresos de hoy</span>
        <span class="cifra" data-total={totalInicial}>{soles(totalInicial)}</span>
        <span class="ultimo" data-ultimo>+ {soles(inicio[0].monto)} · {inicio[0].billetera}</span>
      </div>

      <div class="tarjeta voz">
        <span class="ondas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="frase" data-frase>{inicio[0].nombre} ha {inicio[0].billetera === 'Yape' ? 'yapeado' : 'pagado'}</span>
      </div>

      <div class="tarjeta lista">
        <div class="lista-cab"><span class="etiqueta-demo">Movimientos en vivo</span><span class="punto" aria-hidden="true"></span></div>
        <ul data-lista>
          {inicio.map((m) => (
            <li class="fila"><div class="fila-in">
              <span class="avatar" style={`background: var(--${m.color})`}>{iniciales(m.nombre)}</span>
              <span class="quien"><b>{m.nombre}</b><small>{m.billetera}</small></span>
              <span class="monto">+ {soles(m.monto)}</span>
            </div></li>
          ))}
        </ul>
      </div>
      <span class="nota">{p.nota}</span>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="demo-datos" set:html={JSON.stringify(p.demo)} />

<script>
  type Pago = { nombre: string; billetera: string; color: string; monto: number };
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const soles = (n: number) => 'S/ ' + n.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const verbo = (b: string) => (b === 'Yape' ? 'ha yapeado' : b === 'Plin' ? 'ha plineado' : 'te ha pagado');

  // --- Palabra que cambia (morph de ancho + blur) ---
  const caja = document.querySelector<HTMLElement>('.palabras')!;
  const palabras = [...caja.querySelectorAll<HTMLElement>('.palabra')];
  let w = 0;
  const ajustar = () => { caja.style.width = palabras[w].offsetWidth + 'px'; };
  ajustar();
  addEventListener('resize', ajustar);
  document.fonts?.ready.then(ajustar);

  // --- Demo de pagos ---
  const datos: Pago[] = JSON.parse(document.getElementById('demo-datos')!.textContent!);
  const lista = document.querySelector<HTMLUListElement>('[data-lista]')!;
  const cifra = document.querySelector<HTMLElement>('[data-total]')!;
  const ultimo = document.querySelector<HTMLElement>('[data-ultimo]')!;
  const frase = document.querySelector<HTMLElement>('[data-frase]')!;
  const voz = document.querySelector<HTMLElement>('.voz')!;
  let total = Number(cifra.dataset.total);
  let i = 3;

  const contar = (de: number, a: number) => {
    const t0 = performance.now(), dur = 700;
    const paso = (t: number) => {
      const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      cifra.textContent = soles(de + (a - de) * e);
      if (k < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  };

  // Se clona una fila del servidor para heredar sus estilos con alcance.
  const molde = lista.firstElementChild!.cloneNode(true) as HTMLLIElement;
  const fila = (m: Pago) => {
    const li = molde.cloneNode(true) as HTMLLIElement;
    li.classList.add('nueva');
    const av = li.querySelector<HTMLElement>('.avatar')!;
    av.textContent = m.nombre.split(' ').map((s) => s[0]).slice(0, 2).join('');
    av.style.background = `var(--${m.color})`;
    li.querySelector('b')!.textContent = m.nombre;
    li.querySelector('small')!.textContent = m.billetera;
    li.querySelector('.monto')!.textContent = `+ ${soles(m.monto)}`;
    return li;
  };

  const llegaPago = () => {
    const m = datos[i % datos.length]; i++;
    const li = fila(m);
    lista.prepend(li);
    requestAnimationFrame(() => requestAnimationFrame(() => li.classList.remove('nueva')));
    const sobra = lista.children[3] as HTMLElement | undefined;
    if (sobra) { sobra.classList.add('sale'); setTimeout(() => sobra.remove(), 420); }

    contar(total, total + m.monto); total += m.monto;
    ultimo.textContent = `+ ${soles(m.monto)} · ${m.billetera}`;
    voz.classList.remove('habla'); void voz.offsetWidth; voz.classList.add('habla');
    frase.textContent = `${m.nombre} ${verbo(m.billetera)}`;
  };

  const siguientePalabra = () => {
    palabras[w].classList.remove('activa'); palabras[w].classList.add('sale');
    const prev = palabras[w];
    setTimeout(() => prev.classList.remove('sale'), 420);
    w = (w + 1) % palabras.length;
    palabras[w].classList.add('activa');
    ajustar();
  };

  // Corre solo con la portada a la vista y la pestaña abierta.
  let reloj: number | undefined, visible = false;
  const correr = () => {
    clearInterval(reloj);
    if (quieto || !visible || document.hidden) return;
    reloj = window.setInterval(() => { siguientePalabra(); llegaPago(); }, 2800);
  };
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; correr(); }, { threshold: .2 }).observe(document.querySelector('.portada')!);
  document.addEventListener('visibilitychange', correr);
</script>

<style>
  .portada { padding: clamp(32px, 6vw, 72px) 0 clamp(56px, 8vw, 104px); }
  .rejilla { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .texto { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }

  .vivo { background: var(--sup); color: var(--tinta); height: 32px; padding: 0 12px; }
  .punto { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--ingreso); flex: none; }
  .punto::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; animation: latido 2.4s ease-out infinite; }
  @keyframes latido { 0%, 100% { transform: scale(1); opacity: .9; } 60% { transform: scale(2.4); opacity: 0; } }

  h1 { margin: 0; font-size: clamp(40px, 6.2vw, 76px); font-weight: 700; letter-spacing: -.045em; line-height: 1.02; }
  .linea { display: block; }
  .palabras { position: relative; display: inline-block; height: 1.08em; vertical-align: bottom; transition: width .4s var(--curva); }
  .palabra { position: absolute; left: 0; bottom: 0; white-space: nowrap; opacity: 0; transform: translateY(.35em); filter: blur(8px); transition: opacity .4s var(--curva), transform .4s var(--curva), filter .4s var(--curva); }
  .palabra.activa { opacity: 1; transform: none; filter: none; }
  .palabra.sale { opacity: 0; transform: translateY(-.35em); filter: blur(8px); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .desc { margin: 0; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.55; color: var(--suave); max-width: 50ch; text-wrap: pretty; }
  .botones { display: flex; flex-wrap: wrap; gap: 10px; }
  .grande { height: 54px; padding: 0 24px; font-size: 16px; }

  /* Demo en bento */
  .demo { display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: auto 1fr auto; gap: 12px; position: relative; }
  .tarjeta { padding: 22px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .etiqueta-demo { font-size: 13px; font-weight: 600; opacity: .8; }
  .total { background: var(--marca); color: var(--sobre); }
  .cifra { font-size: clamp(30px, 3.4vw, 40px); font-weight: 700; letter-spacing: -.04em; line-height: 1.05; white-space: nowrap; }
  .ultimo { font-size: 13px; font-weight: 600; opacity: .8; }

  .voz { background: var(--marino); color: var(--marino-tinta); justify-content: space-between; gap: 14px; }
  .ondas { display: flex; gap: 4px; align-items: center; height: 28px; }
  .ondas i { width: 4px; height: 100%; border-radius: 3px; background: var(--marca); transform: scaleY(.25); transform-origin: center; }
  .voz.habla .ondas i { animation: onda .9s var(--curva) both; }
  .voz.habla .ondas i:nth-child(2) { animation-delay: .06s; }
  .voz.habla .ondas i:nth-child(3) { animation-delay: .12s; }
  .voz.habla .ondas i:nth-child(4) { animation-delay: .18s; }
  .voz.habla .ondas i:nth-child(5) { animation-delay: .24s; }
  @keyframes onda { 0%, 100% { transform: scaleY(.25); } 30% { transform: scaleY(1); } 55% { transform: scaleY(.45); } 75% { transform: scaleY(.8); } }
  .frase { font-size: 15px; font-weight: 600; line-height: 1.35; }
  .voz.habla .frase { animation: frase .4s var(--curva) both; }
  @keyframes frase { from { opacity: 0; transform: translateY(6px); filter: blur(3px); } }

  .lista { grid-column: span 2; padding: 18px 12px 10px; }
  .lista-cab { display: flex; justify-content: space-between; align-items: center; padding: 0 10px 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  /* Fila que entra: crece de 0 a su alto (morph de la lista) */
  .fila { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .42s var(--curva), opacity .42s var(--curva); }
  .fila-in { overflow: hidden; min-height: 0; display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: calc(var(--r-tarjeta) - 8px); transition: transform .42s var(--curva), filter .42s var(--curva), background-color .6s ease; }
  .fila.nueva { grid-template-rows: 0fr; opacity: 0; }
  .fila.nueva .fila-in { transform: translateY(-10px) scale(.98); filter: blur(4px); }
  .fila:first-child .fila-in { background: var(--sup2); }
  .fila.sale { grid-template-rows: 0fr; opacity: 0; }
  .avatar { width: 38px; height: 38px; flex: none; border-radius: var(--r-control); display: grid; place-items: center; color: #fff; font-size: 14px; font-weight: 700; }
  @media (prefers-color-scheme: dark) { .avatar { color: #0B0F0D; } }
  .quien { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .quien b { font-size: 14.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .quien small { font-size: 12.5px; color: var(--suave); }
  .monto { font-size: 15px; font-weight: 700; color: var(--ingreso); white-space: nowrap; }
  .nota { grid-column: span 2; justify-self: end; font-size: 12px; color: var(--suave); }

  @media (max-width: 900px) {
    .rejilla { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .demo { grid-template-columns: 1fr; }
    .lista, .nota { grid-column: auto; }
    .botones .btn { flex: 1; }
  }
</style>
